{
  "functions": {
    "api/sync.js": {
      "maxDuration": 15
    },
    "api/plan.js": {
      "maxDuration": 30
    },
    "api/voice.js": {
      "maxDuration": 60
    },
    "api/place.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}